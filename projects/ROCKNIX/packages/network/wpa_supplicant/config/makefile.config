# NetworkManager drives the supplicant over D-Bus; nl80211 only.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_CTRL_IFACE=y
CONFIG_CTRL_IFACE_DBUS_NEW=y
CONFIG_CTRL_IFACE_DBUS_INTRO=y
CONFIG_BACKEND=file
CONFIG_DEBUG_SYSLOG=y
CONFIG_TLS=openssl

# WPA2/WPA3 personal and enterprise
CONFIG_IEEE8021X_EAPOL=y
CONFIG_EAP_MD5=y
CONFIG_EAP_MSCHAPV2=y
CONFIG_EAP_TLS=y
CONFIG_EAP_PEAP=y
CONFIG_EAP_TTLS=y
CONFIG_EAP_GTC=y
CONFIG_EAP_PWD=y
CONFIG_PKCS12=y
CONFIG_SAE=y
CONFIG_OWE=y

# Roaming, Wi-Fi 6/7 (EHT and MLO) and NetworkManager hotspots
CONFIG_IEEE80211R=y
CONFIG_WNM=y
CONFIG_BGSCAN_SIMPLE=y
CONFIG_IEEE80211AC=y
CONFIG_IEEE80211AX=y
CONFIG_IEEE80211BE=y
CONFIG_AP=y
