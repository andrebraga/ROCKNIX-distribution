Fix GCC 16 build: mem/atomic.h uses uintNN_t without <cstdint>.

GCC 16 no longer transitively includes <cstdint>, so uint16_t/uint32_t/
uint64_t in atomic.h are undeclared. Include <cstdint> explicitly.

diff --git a/vita3k/mem/include/mem/atomic.h b/vita3k/mem/include/mem/atomic.h
--- a/vita3k/mem/include/mem/atomic.h
+++ b/vita3k/mem/include/mem/atomic.h
@@ -18,6 +18,7 @@
 #pragma once
 
 #include <memory>
+#include <cstdint>
 
 #ifdef _MSC_VER
 #include <intrin.h>
