+
+/// Waits until fd is readable or the timeout passes.
+fn wait_readable(fd: RawFd, timeout: Duration) {
+    // SAFETY: the caller holds the device that owns fd for the whole wait.
+    let fd = unsafe { BorrowedFd::borrow_raw(fd) };
+    let mut fds = [PollFd::new(fd, PollFlags::POLLIN)];
+    let millis = timeout.as_millis().clamp(1, u16::MAX as u128) as u16;
+    let _ = poll(&mut fds, PollTimeout::from(millis));
+}
