[Unit]
Description=Save system clock to UEFI RTCInfo (SSOT)
# Wait for the block device symlink to be created by udev.
Wants=dev-disk-by\x2dpartlabel-uefivarstore.device
After=dev-disk-by\x2dpartlabel-uefivarstore.device local-fs.target
# Run ExecStop before shutdown/reboot/halt/poweroff targets are reached.
Before=shutdown.target reboot.target halt.target poweroff.target
Conflicts=shutdown.target reboot.target halt.target poweroff.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/usr/bin/uefivar rtc-set now

[Install]
WantedBy=multi-user.target
