[Unit]
Description=Load system clock from UEFI RTCInfo (SSOT)
# Wait for the specific block device symlink to be created by udev.
# This automatically waits for UFS + partition table scan + udev rules.
Wants=dev-disk-by\x2dpartlabel-uefivarstore.device
After=dev-disk-by\x2dpartlabel-uefivarstore.device
# Run before anything that consumes wall time (NTP, user services).
Before=time-sync.target multi-user.target
ConditionPathExists=/sys/class/rtc/rtc0/since_epoch

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/uefivar rtc-get --set-system-clock

[Install]
WantedBy=multi-user.target
