# Nothing uses the compute DSP. While the AOP counts it as loaded, suspend
# cannot power down the whole SoC; stopping it reports it off to the AOP.

. /etc/profile

cdsp_off() {
  local rproc tries
  for rproc in /sys/class/remoteproc/remoteproc*
  do
    [ "$(cat ${rproc}/name 2>/dev/null)" = "cdsp" ] || continue
    for tries in $(seq 30)
    do
      [ "$(cat ${rproc}/state)" = "running" ] && break
      sleep 1
    done
    echo stop > ${rproc}/state
  done
}

cdsp_off &
