From b2bf29ee103d00ba85aa5ae8dfd70f37a2791867 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Andr=C3=A9=20Braga?= <code@andrebraga.com>
Date: Wed, 4 Nov 2026 12:13:31 +0000
Subject: [PATCH] Idle without spinning, and release the audio device

SDL2 pumps events every millisecond while joysticks are open, so the
power saver's long SDL_WaitEventTimeout became a 1 kHz busy loop on any
device with a gamepad attached. Wait in 40 ms steps instead, the same
granularity the default power saver mode already uses.

The audio device also stayed open forever, keeping the sound server's
sink and the DSP behind it running. Close it when the power saver goes
idle with nothing playing, and reopen it for the next sound or song.
---
 es-app/src/main.cpp          | 32 ++++++++++++++++++++++++++++++--
 es-core/src/AudioManager.cpp | 19 +++++++++++++++++++
 es-core/src/AudioManager.h   |  6 ++++++
 es-core/src/Sound.cpp        |  7 +++++--
 4 files changed, 60 insertions(+), 4 deletions(-)

diff --git a/es-app/src/main.cpp b/es-app/src/main.cpp
index edd28e1..d8c60ae 100644
--- a/es-app/src/main.cpp
+++ b/es-app/src/main.cpp
@@ -18,8 +18,10 @@
 #include "SystemData.h"
 #include "SystemScreenSaver.h"
 #include <SDL_events.h>
+#include <SDL_joystick.h>
 #include <SDL_main.h>
 #include <SDL_timer.h>
+#include <algorithm>
 #include <iostream>
 #include <time.h>
 #include "LocaleES.h"
@@ -462,6 +464,29 @@ void launchStartupGame()
 
 // #include "utils/MathExpr.h"
 
+// While joysticks are open SDL2 pumps events every millisecond, which turns a
+// long SDL_WaitEventTimeout into a busy loop. Sleep in coarse steps instead.
+static int waitEventTimeout(SDL_Event* event, int timeout)
+{
+	if (SDL_NumJoysticks() == 0)
+		return SDL_WaitEventTimeout(event, timeout);
+
+	const int step = 40;
+	int start = SDL_GetTicks();
+
+	while (true)
+	{
+		if (SDL_PollEvent(event))
+			return 1;
+
+		int elapsed = SDL_GetTicks() - start;
+		if (timeout >= 0 && elapsed >= timeout)
+			return 0;
+
+		SDL_Delay(timeout < 0 ? step : std::min(step, timeout - elapsed));
+	}
+}
+
 int main(int argc, char* argv[])
 {
 	// Utils::MathExpr::performUnitTests();
@@ -727,9 +752,12 @@ int main(int argc, char* argv[])
 		int eventResult;
 
 		if (screenSaverWait)
-			eventResult = SDL_WaitEventTimeout(&event, screenSaverTimeout);
+			eventResult = waitEventTimeout(&event, screenSaverTimeout);
 		else if (ps_standby)
-			eventResult = SDL_WaitEventTimeout(&event, PowerSaver::getTimeout());
+		{
+			AudioManager::getInstance()->suspendIfIdle();
+			eventResult = waitEventTimeout(&event, PowerSaver::getTimeout());
+		}
 		else
 			eventResult = SDL_PollEvent(&event);
 
