@@ -64,6 +64,7 @@ void AudioManager::init()
 	if (mInitialized)
 		return;
 	
+	mIdleSuspended = false;
 	mSongNameChanged = false;
 	mPlayingSystemThemeSong = "none";
 	std::deque<std::string> mLastPlayed;
@@ -103,6 +104,7 @@ void AudioManager::deinit()
 	LOG(LogDebug) << "AudioManager::deinit";
 
 	mInitialized = false;
+	mIdleSuspended = false;
 
 	//stop all playback
 	stop();
@@ -122,6 +124,21 @@ void AudioManager::deinit()
 	LOG(LogInfo) << "SDL AUDIO Deinitialized";
 }
 
+void AudioManager::suspendIfIdle()
+{
+	if (!mInitialized || mCurrentMusic != nullptr || mVideoPlaying || Mix_Playing(-1) > 0)
+		return;
+
+	deinit();
+	mIdleSuspended = true;
+}
+
+void AudioManager::resumeIfSuspended()
+{
+	if (mIdleSuspended)
+		init();
+}
+
 void AudioManager::registerSound(std::shared_ptr<Sound> & sound)
 {
 	getInstance();
@@ -403,6 +420,8 @@ static std::string decode_text_frame(const ID3v2_TextFrameData* data)
 
 void AudioManager::playMusic(const std::string& path)
 {
+	resumeIfSuspended();
+
 	if (!mInitialized)
 		return;
 
