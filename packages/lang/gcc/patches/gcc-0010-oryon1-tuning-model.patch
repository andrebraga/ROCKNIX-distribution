Add a dedicated Qualcomm Oryon-1 (SM8750) cost/tuning model to GCC 16.
Derived from the GCC 15 oryon1 model, re-based onto GCC 16.1: keeps the
cortexa57 scheduler automaton, retargets only the cost model to oryon1,
and adds the new tune_params dispatch_constraints trailing field. RPRES
is omitted (not present in GCC 16's aarch64 extensions).

diff --git a/gcc/config/aarch64/aarch64.cc b/gcc/config/aarch64/aarch64.cc
--- a/gcc/config/aarch64/aarch64.cc
+++ b/gcc/config/aarch64/aarch64.cc
@@ -418,6 +418,7 @@
 #include "tuning_models/cortexa72.h"
 #include "tuning_models/cortexa73.h"
 #include "tuning_models/cortexx925.h"
+#include "tuning_models/oryon1.h"
 #include "tuning_models/exynosm1.h"
 #include "tuning_models/thunderxt88.h"
 #include "tuning_models/thunderx.h"
diff --git a/gcc/config/aarch64/aarch64-cores.def b/gcc/config/aarch64/aarch64-cores.def
--- a/gcc/config/aarch64/aarch64-cores.def
+++ b/gcc/config/aarch64/aarch64-cores.def
@@ -158,7 +158,7 @@
 /* ARMv8.6-A Architecture Processors.  */
 
 /* Qualcomm ('Q') cores. */
-AARCH64_CORE("oryon-1", oryon1, cortexa57, V8_6A, (CRYPTO, SM4, SHA3, F16), cortexa72,   0x51, 0x001, -1)
+AARCH64_CORE("oryon-1", oryon1, cortexa57, V8_6A, (CRYPTO, SM4, SHA3, F16), oryon1,   0x51, 0x001, -1)
 
 /* ARMv8-A big.LITTLE implementations.  */
 
diff --git a/gcc/config/aarch64/tuning_models/oryon1.h b/gcc/config/aarch64/tuning_models/oryon1.h
new file mode 100644
--- /dev/null
+++ b/gcc/config/aarch64/tuning_models/oryon1.h
@@ -0,0 +1,152 @@
